# ============================================================
# MedAssist AI - Environment Configuration
# ============================================================

# General Application Settings
APP_NAME="MedAssist AI"
APP_ENV="development"
DEBUG=True
PORT=8000
HOST="0.0.0.0"
API_V1_STR="/api"

# Security & Authentication
# Generated random secret key for JWT signing
SECRET_KEY="medassist-super-secret-development-jwt-key-replace-in-production-min-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration
# For PostgreSQL: postgresql+psycopg2://user:password@localhost:5432/medassist_db
# For Local SQLite: sqlite:///./data/medassist.db
DATABASE_URL="sqlite:///./data/medassist.db"

# Redis Configuration (Optional in local dev, in-memory fallback enabled)
REDIS_URL="redis://localhost:6379/0"
USE_REDIS=False

# LLM Provider Configuration
# Supported providers: groq, gemini, openai, anthropic, huggingface, mock
LLM_PROVIDER="groq"
GROQ_API_KEY=""
GOOGLE_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
LLM_MODEL="openai/gpt-oss-120b"
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048

# RAG & Embeddings
# Supported embedding providers: sentence-transformers, gemini, openai, mock
EMBEDDING_PROVIDER="sentence-transformers"
EMBEDDING_MODEL="all-MiniLM-L6-v2"
VECTOR_STORE_TYPE="chroma"
CHROMA_PERSIST_DIR="./data/chroma_db"
CHUNK_SIZE=500
CHUNK_OVERLAP=100
TOP_K_RETRIEVAL=5
RERANKER_ENABLED=True

# ML & DL Configuration
ML_MODEL_PATH="./ml/saved_models/doc_classifier.joblib"
DL_MODEL_NAME="distilbert-base-uncased"
DL_DEVICE="cpu"

# Storage & Upload Limits
STORAGE_DIR="./data/documents"
MAX_UPLOAD_SIZE_MB=25
ALLOWED_EXTENSIONS=["pdf", "docx", "txt", "csv"]

# Observability & Logging
LOG_LEVEL="INFO"
LOG_FORMAT="json"
AUDIT_LOG_ENABLED=True

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Frontend Configuration
NEXT_PUBLIC_API_URL="http://localhost:8000"
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000", "http://localhost:8000"]
